# ====================================================================
# Containerizing a College Portal - Environment Configuration
# ====================================================================

# Port Bindings on Host Machine
FRONTEND_PORT=3000
BACKEND_PORT=5000
DB_PORT=5432

# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database Credentials
DB_HOST=localhost
DB_NAME=college_portal
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass

# Security & Tokens
JWT_SECRET=super_secret_ibm_portal_key_2026
SESSION_LIFETIME=86400
