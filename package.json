{
  "name": "containerizing-a-college-portal",
  "version": "1.0.0",
  "description": "Full-stack multi-tier containerized college management portal (IBM Project Submission)",
  "scripts": {
    "postinstall": "cd backend && npm install",
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "ibm",
    "docker",
    "containerization",
    "college-portal",
    "express",
    "postgresql",
    "nginx"
  ],
  "author": "Apex Institute / IBM Academic Project",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5"
  }
}
